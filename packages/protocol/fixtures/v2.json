{
  "protocolVersion": 2,
  "description": "Canonical wire-format fixtures for the decent render-network protocol v2. Rust (crates/supervisor-core) and TS (@decent-render/protocol) BOTH assert against these — a field present in a fixture but missing from an implementation fails that implementation's test. This is the drift tripwire (the outputSizeInBytes scar is covered by the two jobComplete variants). The `reject` array is the negative contract: every entry MUST fail to parse on both sides, so a schema that silently loosens (accepting protocolVersion 99, progress 1.5, codec av1) is caught here.",
  "cases": [
    {
      "name": "register (capabilities without the newer hardware fields)",
      "direction": "worker",
      "wire": {
        "type": "register",
        "tenant": "driffs",
        "protocolVersion": 2,
        "operator": null,
        "platform": "company",
        "chip": "Apple M4 Max (darwin)",
        "ramGb": 64,
        "supervisorVersion": "spike-0.0.2",
        "payloadVersion": "none",
        "capabilities": {
          "gpu": true
        }
      }
    },
    {
      "name": "register (full capabilities — hardware, not willingness)",
      "direction": "worker",
      "wire": {
        "type": "register",
        "tenant": "driffs",
        "protocolVersion": 2,
        "operator": null,
        "platform": "company",
        "chip": "Apple M4 Max (darwin)",
        "ramGb": 64,
        "supervisorVersion": "spike-0.0.2",
        "payloadVersion": "none",
        "capabilities": {
          "gpu": true,
          "maxConcurrentJobs": 1,
          "os": "macos",
          "arch": "aarch64"
        }
      }
    },
    {
      "name": "heartbeat",
      "direction": "worker",
      "wire": {
        "type": "heartbeat",
        "tenant": "driffs",
        "currentJobCount": 0
      }
    },
    {
      "name": "jobAccepted",
      "direction": "worker",
      "wire": {
        "type": "jobAccepted",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1
      }
    },
    {
      "name": "jobProgress",
      "direction": "worker",
      "wire": {
        "type": "jobProgress",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "progress": 0.5
      }
    },
    {
      "name": "jobProgress (accrued measurements PRESENT — elapsedMs + framesSoFar, F2)",
      "direction": "worker",
      "wire": {
        "type": "jobProgress",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "progress": 0.35,
        "elapsedMs": 8453,
        "framesSoFar": 105
      }
    },
    {
      "name": "jobComplete (outputSizeInBytes ABSENT — the drift scar)",
      "direction": "worker",
      "wire": {
        "type": "jobComplete",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "outputKey": "renders/t1/out.mp4",
        "metrics": {
          "wallMs": 12345,
          "frames": 300
        }
      }
    },
    {
      "name": "jobComplete (outputSizeInBytes PRESENT — the drift scar)",
      "direction": "worker",
      "wire": {
        "type": "jobComplete",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "outputKey": "renders/t1/out.mp4",
        "metrics": {
          "wallMs": 12345,
          "frames": 300,
          "outputSizeInBytes": 647399
        }
      }
    },
    {
      "name": "jobFailed",
      "direction": "worker",
      "wire": {
        "type": "jobFailed",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "reason": "bundle sha mismatch"
      }
    },
    {
      "name": "jobRejected (not-accepting)",
      "direction": "worker",
      "wire": {
        "type": "jobRejected",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "reason": "not-accepting"
      }
    },
    {
      "name": "jobRejected (busy, attempt ABSENT)",
      "direction": "worker",
      "wire": {
        "type": "jobRejected",
        "tenant": "driffs",
        "jobId": "spike-1",
        "reason": "busy"
      }
    },
    {
      "name": "jobCanceledAck (teardownMs PRESENT — the witness measurement, F4)",
      "direction": "worker",
      "wire": {
        "type": "jobCanceledAck",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "teardownMs": 812
      }
    },
    {
      "name": "jobCanceledAck (teardownMs ABSENT — a node that cannot measure teardown, F4)",
      "direction": "worker",
      "wire": {
        "type": "jobCanceledAck",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1
      }
    },
    {
      "name": "jobAssign (browser ABSENT — payload bundles its own chrome/)",
      "direction": "server",
      "wire": {
        "type": "jobAssign",
        "tenant": "driffs",
        "jobId": "job-render-abc123",
        "attempt": 1,
        "kind": "gpu",
        "durationFrames": 300,
        "fps": 30,
        "codec": "h264",
        "bundleSha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
        "bundleGetUrl": "https://r2.example.com/bundles/9f86.tar.gz?sig=1",
        "payloadSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "payloadGetUrl": "https://r2.example.com/render-payloads/aaaa.tar.gz?sig=payload",
        "inputPropsGetUrl": "https://r2.example.com/renders/t1/input-props.json?sig=2",
        "assetGetUrls": [
          "https://r2.example.com/assets/a.png?sig=3"
        ],
        "outputPutUrl": "https://r2.example.com/renders/t1/out.mp4?sig=4",
        "outputKey": "renders/t1/out.mp4",
        "purgeAfter": true
      }
    },
    {
      "name": "jobAssign (browser split out — standalone content-addressed browser artifact)",
      "direction": "server",
      "wire": {
        "type": "jobAssign",
        "tenant": "driffs",
        "jobId": "job-render-abc123",
        "attempt": 1,
        "kind": "gpu",
        "durationFrames": 300,
        "fps": 30,
        "codec": "h264",
        "bundleSha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
        "bundleGetUrl": "https://r2.example.com/bundles/9f86.tar.gz?sig=1",
        "payloadSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "payloadGetUrl": "https://r2.example.com/render-payloads/aaaa.tar.gz?sig=payload",
        "browserSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "browserGetUrl": "https://r2.example.com/render-browsers/bbbb.tar.gz?sig=browser",
        "inputPropsGetUrl": "https://r2.example.com/renders/t1/input-props.json?sig=2",
        "assetGetUrls": [
          "https://r2.example.com/assets/a.png?sig=3"
        ],
        "outputPutUrl": "https://r2.example.com/renders/t1/out.mp4?sig=4",
        "outputKey": "renders/t1/out.mp4",
        "purgeAfter": true
      }
    },
    {
      "name": "cancel",
      "direction": "server",
      "wire": {
        "type": "cancel",
        "tenant": "driffs",
        "jobId": "job-render-abc123"
      }
    },
    {
      "name": "ping",
      "direction": "server",
      "wire": {
        "type": "ping",
        "tenant": "driffs"
      }
    },
    {
      "name": "updateAvailable",
      "direction": "server",
      "wire": {
        "type": "updateAvailable",
        "tenant": "driffs",
        "supervisorVersion": "rust-0.0.2",
        "payloadVersion": "remotion-4.0.339"
      }
    }
  ],
  "reject": [
    {
      "name": "register with an unsupported protocolVersion (99)",
      "direction": "worker",
      "reason": "PROTOCOL_VERSION is pinned to 2 on both sides; a node speaking any other version must not be accepted as if it were v2.",
      "wire": {
        "type": "register",
        "tenant": "driffs",
        "protocolVersion": 99,
        "operator": null,
        "platform": "company",
        "chip": "Apple M4 Max (darwin)",
        "ramGb": 64,
        "supervisorVersion": "spike-0.0.2",
        "payloadVersion": "none",
        "capabilities": {
          "gpu": true
        }
      }
    },
    {
      "name": "jobProgress out of range (1.5)",
      "direction": "worker",
      "reason": "progress is a fraction in [0, 1]; a value outside it is a runner bug, not a wire value to forward.",
      "wire": {
        "type": "jobProgress",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "progress": 1.5
      }
    },
    {
      "name": "jobProgress negative (-0.1)",
      "direction": "worker",
      "reason": "progress is a fraction in [0, 1].",
      "wire": {
        "type": "jobProgress",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "progress": -0.1
      }
    },
    {
      "name": "jobProgress with negative framesSoFar",
      "direction": "worker",
      "reason": "framesSoFar is a raw frame COUNT (F2 accrued protocol); a negative count is a runner bug, and dispatch must never price a negative accrual off it. Integer ≥ 0 or absent — same for elapsedMs.",
      "wire": {
        "type": "jobProgress",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "progress": 0.35,
        "framesSoFar": -12
      }
    },
    {
      "name": "jobCanceledAck with attempt ABSENT",
      "direction": "worker",
      "reason": "attempt is REQUIRED on the cancel-ack (F4): it is the provenance key — dispatch's idempotent write predicate is (jobId, attempt). Without it a requeued job could inherit an earlier attempt's ack.",
      "wire": {
        "type": "jobCanceledAck",
        "tenant": "driffs",
        "jobId": "spike-1",
        "teardownMs": 812
      }
    },
    {
      "name": "jobCanceledAck with negative teardownMs",
      "direction": "worker",
      "reason": "teardownMs measures ms from cancel receipt to process-tree dead + purge done — a duration, never negative. Integer >= 0 or absent (u64 on the Rust side rejects it at parse).",
      "wire": {
        "type": "jobCanceledAck",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": 1,
        "teardownMs": -5
      }
    },
    {
      "name": "jobCanceledAck with a string attempt",
      "direction": "worker",
      "reason": "attempt is an integer lease number on the wire; a stringified number is not a wire value to coerce.",
      "wire": {
        "type": "jobCanceledAck",
        "tenant": "driffs",
        "jobId": "spike-1",
        "attempt": "1",
        "teardownMs": 812
      }
    },
    {
      "name": "jobAssign with an unknown codec (av1)",
      "direction": "server",
      "reason": "codec is the closed set h264 | vp8; an unknown codec cannot be rendered and must fail to parse rather than reach the runner.",
      "wire": {
        "type": "jobAssign",
        "tenant": "driffs",
        "jobId": "job-render-abc123",
        "attempt": 1,
        "kind": "gpu",
        "durationFrames": 300,
        "fps": 30,
        "codec": "av1",
        "bundleSha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
        "bundleGetUrl": "https://r2.example.com/bundles/9f86.tar.gz?sig=1",
        "payloadSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "payloadGetUrl": "https://r2.example.com/render-payloads/aaaa.tar.gz?sig=payload",
        "inputPropsGetUrl": "https://r2.example.com/renders/t1/input-props.json?sig=2",
        "assetGetUrls": [
          "https://r2.example.com/assets/a.png?sig=3"
        ],
        "outputPutUrl": "https://r2.example.com/renders/t1/out.mp4?sig=4",
        "outputKey": "renders/t1/out.mp4",
        "purgeAfter": true
      }
    }
  ]
}
