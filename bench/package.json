{
  "name": "@decent-render/bench",
  "version": "0.0.0",
  "private": true,
  "description": "Golden benchmark suite + measurement harness for the Decent render network. Drives the REAL compiled runner path (bun --compile, temp cwd) so measurements reflect what an operator node actually does.",
  "type": "module",
  "scripts": {
    "bundle": "bun src/bundle.ts",
    "build:runner": "bun build --compile --minify --target=bun-darwin-arm64 --outfile .bench/decent-render-runner src/runner-entry.ts && rm -rf .bench/remotion-binaries && cp -R node_modules/@remotion/compositor-darwin-arm64 .bench/remotion-binaries",
    "bench": "bun src/bench.ts"
  },
  "dependencies": {
    "@decent-render/protocol": "^0.1.1",
    "@decent-render/runner-core": "file:../packages/runner-core",
    "@remotion/bundler": "4.0.506",
    "@remotion/compositor-darwin-arm64": "4.0.506",
    "@remotion/renderer": "4.0.506",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.506"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.4.0"
  }
}
